# =====================================================================
# 生产部署配置模板
# 用法：
#   cp infra/docker/.env.prod.example .env.prod
#   # 填好后（下面标了「必须改」的项都要改）
#   docker compose -f infra/docker/docker-compose.prod.yml --env-file .env.prod up -d --build
#
# 注意：.env.prod 含密钥，已在 .gitignore 中排除，不要提交。
# =====================================================================

# ---- 站点地址 ----
# 用 IP + HTTP 先跑通时填 http://152.136.255.253
# 之后换成域名 + HTTPS 时，改成 https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://152.136.255.253

# ---- 环境 ----
# 用 HTTP + IP 访问时必须设为 development：生产模式下会话 Cookie 带
# Secure 标记，浏览器在 http:// 下会直接丢弃它，表现为「登录成功但立刻掉线」。
# 换成 HTTPS 后再改成 production。
APP_ENV=development
LOG_LEVEL=info
# 只用于镜像内的版本号（/health 与日志可见），随便改。
VERSION=prod

# ---- PostgreSQL（必须改密码）----
POSTGRES_USER=thesis
POSTGRES_PASSWORD=CHANGE_ME_强密码
POSTGRES_DB=thesis

# ---- 对象存储 ----
# 浏览器直传用的地址：必须是这台机器的公网 IP + nginx 端口。
# 签名覆盖 host，写错会表现为「上传返回 403 SignatureDoesNotMatch」。
S3_PUBLIC_ENDPOINT=152.136.255.253
S3_ACCESS_KEY=CHANGE_ME_随机字符串
S3_SECRET_KEY=CHANGE_ME_另一个随机字符串
S3_BUCKET=thesis-files
# 服务端连容器内网的 SeaweedFS，始终是明文 http。
S3_USE_SSL=false
# 预签名 URL 用的协议，独立于上面一项。
# 公网走 HTTPS 时必须是 true，否则浏览器会拦混合内容。
S3_PUBLIC_USE_SSL=false

# ---- 认证（必须改）----
# 生成：openssl rand -base64 48
JWT_SECRET=CHANGE_ME_至少32字节的随机串

# ---- 协同编辑 ----
# 浏览器直连的 WebSocket 地址，由 nginx 的 /collab 转发到 ws:1234。
# 换成 HTTPS 后改成 wss://your-domain.com/collab。
NEXT_PUBLIC_WS_URL=ws://152.136.255.253/collab
WS_PUBLIC_URL=ws://152.136.255.253/collab

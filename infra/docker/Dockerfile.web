# Next.js 生产镜像。
#
# 不用 `output: standalone`：本仓库是 pnpm workspace，standalone 会尝试把
# 根 node_modules 里的 .pnpm 目录（符号链接结构）整体复制进产物，
# 在部分环境下会因为符号链接权限失败，且体积不比直接装依赖小。
# 这里改为「构建产物 + 精简依赖」：.next 只含编译结果，node_modules
# 由 pnpm 按生产依赖单独装一份。
#
# 构建上下文是仓库根目录（见 compose 的 context: ../..）。

# ---- 依赖 ----
FROM node:22-alpine AS deps
RUN corepack enable && corepack prepare pnpm@11.1.3 --activate
WORKDIR /repo

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/package.json
COPY apps/ws/package.json apps/ws/package.json

RUN pnpm install --frozen-lockfile --filter @thesis/web...

# ---- 构建 ----
FROM node:22-alpine AS build
RUN corepack enable && corepack prepare pnpm@11.1.3 --activate
WORKDIR /repo

COPY --from=deps /repo/node_modules ./node_modules
COPY --from=deps /repo/apps/web/node_modules ./apps/web/node_modules
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web ./apps/web

# NEXT_PUBLIC_* 与 rewrites 都在**构建期**求值并写进产物，运行时改无效，
# 所以必须在这里通过 build args 传入。
#   NEXT_PUBLIC_API_URL 留空 → 浏览器走同源相对路径，由 nginx 转发；
#   API_INTERNAL_URL       → 构建期写进 rewrites，SSR 直连容器内网。
ARG NEXT_PUBLIC_API_URL=""
ARG NEXT_PUBLIC_WS_URL="wss://example.invalid"
ARG NEXT_PUBLIC_SITE_URL="http://localhost"
ARG API_INTERNAL_URL="http://api:8080"

ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL} \
    NEXT_PUBLIC_WS_URL=${NEXT_PUBLIC_WS_URL} \
    NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL} \
    API_INTERNAL_URL=${API_INTERNAL_URL} \
    NEXT_TELEMETRY_DISABLED=1

RUN pnpm --filter @thesis/web build

# ---- 运行 ----
FROM node:22-alpine AS runtime
RUN corepack enable && corepack prepare pnpm@11.1.3 --activate
WORKDIR /repo

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

# 生产依赖单独装一份，只保留 web 需要的包。
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/package.json
COPY apps/ws/package.json apps/ws/package.json
RUN pnpm install --frozen-lockfile --prod --filter @thesis/web... \
    && pnpm store prune

# 编译产物与配置。next.config.mjs 必须一起带上：rewrites 在 `next start`
# 时还会被读取一次，缺了它 SSR 请求就找不到后端。
COPY --from=build /repo/apps/web/.next ./apps/web/.next
COPY --from=build /repo/apps/web/next.config.mjs ./apps/web/next.config.mjs
COPY --from=build /repo/apps/web/package.json ./apps/web/package.json

RUN addgroup -S app && adduser -S -G app app && chown -R app:app /repo
USER app

WORKDIR /repo
EXPOSE 3000
# 用 pnpm 跑 package.json 里的 start 脚本，而不是拼 node_modules/.bin 路径：
# pnpm 把依赖放在各包自己的 node_modules 下（apps/web/node_modules/next），
# 根目录没有 .bin/next，写死路径会 MODULE_NOT_FOUND。
# 运行镜像已启用 corepack，pnpm 可用。
CMD ["pnpm", "--filter", "@thesis/web", "start"]

# ---- 环境 ----
APP_ENV=development
LOG_LEVEL=debug

# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=thesis
POSTGRES_PASSWORD=thesis_dev
POSTGRES_DB=thesis

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- MinIO / S3 ----
S3_ENDPOINT=localhost:8333
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=thesis-files
S3_USE_SSL=false

# ---- API (Go) ----
API_ADDR=:8080
API_PUBLIC_URL=http://localhost:8080

# ---- Auth ----
JWT_SECRET=dev-only-change-me
JWT_TTL=168h

# ---- Web (Next.js) ----
NEXT_PUBLIC_API_URL=http://localhost:8080

# ---- 协同服务 (apps/ws) ----
WS_PORT=1234
WS_HEALTH_PORT=1235
WS_PUBLIC_URL=ws://localhost:1234
NEXT_PUBLIC_WS_URL=ws://localhost:1234
